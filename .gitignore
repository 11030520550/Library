## .gitignore for Visual Studio / .NET projects

# Visual Studio cache / options
.vs/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Build results
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Ll]og/
[Ll]ogs/
artifacts/
publish/
*.pubxml
*.publishproj

# NuGet
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/
project.lock.json
project.fragment.lock.json

# Test results
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml
coverage*.json

# Visual Studio profiler / misc tooling
*.psess
*.vsp
*.vspx
*.sap
_ReSharper*/
*.DotSettings.user
.idea/

# Local secrets / environment overrides
appsettings.*.local.json
secrets.json
.env
*.env

# Database files
*.mdf
*.ldf
*.ndf

# Temporary and OS files
*.tmp
*.temp
*.bak
*.swp
*.log
~$*
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
